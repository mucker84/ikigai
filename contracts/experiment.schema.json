{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizes.online/iki/schemas/experiment.schema.json",
  "title": "CatalogExperiment",
  "description": "Schéma pro jednu položku katalogu experimentů v aplikaci IKI",
  "type": "object",
  "required": [
    "id",
    "code",
    "title",
    "summary",
    "instructions",
    "estimatedMinutes",
    "tags",
    "variants",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Unikátní stabilní identifikátor pokusu"
    },
    "code": {
      "type": "string",
      "pattern": "^EXP-[0-9]{2,3}$",
      "description": "Katalogové označení (např. EXP-01)"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "description": "Krátký název pokusu"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "description": "Stručný účel pokusu (proč to děláme)"
    },
    "instructions": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000,
      "description": "Kroky k provedení pokusu v reálném světě"
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "description": "Odhadovaná časová náročnost v minutách"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Tematické štítky (např. 'tvorba', 'struktura', 'mentoring')"
    },
    "variants": {
      "type": "array",
      "description": "Zkrácené nebo odlehčené Kaizen varianty pokusu",
      "items": {
        "type": "object",
        "required": ["id", "title", "instructions", "estimatedMinutes"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "instructions": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "estimatedMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "additionalProperties": false
      }
    },
    "version": {
      "type": "string",
      "description": "Verze obsahu experimentu (např. '2026-10-09' nebo '1.0.0')"
    }
  },
  "additionalProperties": false
}
